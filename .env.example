# Porta do servidor local (acessível no notebook e no tablet pela mesma rede Wi-Fi)
PORT=3000

# Interface de escuta (0.0.0.0 aceita conexões de outros dispositivos na rede local)
HOST=0.0.0.0

# Pasta onde ficam os bancos SQLite (rodizio.db, demo.db, sistema.db), fotos e backups
DATA_DIR=data

# PIN inicial da área administrativa da recepção (pode ser alterado na interface em Sistema)
ADMIN_PIN=1234

# Intervalo de backup automático (em horas) e quantidade de arquivos mantidos
BACKUP_EVERY_HOURS=6
BACKUP_KEEP=30

